---
import MenuList from '../MenuList.astro';
import MenuImagePopup from '../MenuImagePopup.astro';
import { useTranslations } from '../../i18n/ui.js';
import { site } from '../../data/site.js';
const { lang = 'fr' } = Astro.props;
const t = useTranslations(lang);
---
<section class="section container">
  <h1 class="section-title">{t('menu.title')}</h1>
  <p class="section-intro">{t('menu.intro')}</p>
  <MenuImagePopup />
  <MenuList lang={lang} preview={false} />
</section>
