---
// Carte par sections (rendu serveur, excellent SEO). `preview` = aperçu accueil.
import { menu, tr } from '../data/menu.js';
import { useTranslations, localizedPath } from '../i18n/ui.js';
const { lang = 'fr', preview = false } = Astro.props;
const t = useTranslations(lang);
// En aperçu : 2 catégories phares (kebabs + pizzas), 3 items max chacune.
const cats = preview ? menu.filter((c) => ['kebabs', 'pizzas'].includes(c.cat)) : menu;
---
<div class="menu-list">
  {!preview && <p class="menu-demo-notice">{t('menu.demoNotice')}</p>}
  {cats.map((c) => (
    <section class="menu-cat">
      <h3 class="menu-cat-title">{t('menu.cat.' + c.cat)}</h3>
      <ul class="menu-items">
        {(preview ? c.items.slice(0, 3) : c.items).map((item) => (
          <li class="menu-item">
            <div class="menu-item-head">
              <span class="menu-item-name">{tr(item.name, lang)}</span>
              <span class="menu-item-dots"></span>
              <span class="menu-item-price">{item.price}</span>
            </div>
            {item.desc && <p class="menu-item-desc">{tr(item.desc, lang)}</p>}
          </li>
        ))}
      </ul>
    </section>
  ))}
  {!preview && <p class="menu-allergens">{t('menu.allergens')}</p>}
  {preview && (
    <p class="menu-more">
      <a class="btn btn-outline" href={localizedPath('menu', lang)}>{t('menu.seeFullMenu')}</a>
    </p>
  )}
</div>
<style>
  .menu-list{max-width:760px;margin:0 auto}
  .menu-demo-notice{background:#fff6e5;border:1px solid var(--color-accent);border-radius:10px;padding:.7rem 1rem;font-size:.9rem;text-align:center}
  .menu-cat{margin:2rem 0}
  .menu-cat-title{color:var(--color-primary);border-bottom:2px solid var(--color-accent);padding-bottom:.3rem;display:inline-block}
  .menu-items{list-style:none;padding:0;margin:1rem 0 0}
  .menu-item{padding:.6rem 0;border-bottom:1px dashed var(--color-border)}
  .menu-item-head{display:flex;align-items:baseline;gap:.5rem}
  .menu-item-name{font-weight:700}
  .menu-item-dots{flex:1;border-bottom:2px dotted var(--color-border);transform:translateY(-4px)}
  .menu-item-price{font-weight:700;color:var(--color-primary)}
  .menu-item-desc{margin:.2rem 0 0;color:var(--color-muted);font-size:.9rem}
  .menu-allergens{margin-top:2rem;font-size:.85rem;color:var(--color-muted);text-align:center}
  .menu-more{text-align:center;margin-top:2rem}
</style>
