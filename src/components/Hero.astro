---
// Hero — image enseigne + tagline + CTA Commander / Wolt.
import { useTranslations } from '../i18n/ui.js';
import { site } from '../data/site.js';
const { lang = 'fr', image = '/hero.jpg' } = Astro.props;
const t = useTranslations(lang);
---
<section class="hero" style={`background-image:url('${image}')`}>
  <div class="hero-overlay">
    <div class="container hero-content">
      <img src="/logo.png" alt="Bonus Kebab" class="hero-logo" width="120" height="120" />
      <h1>{t('hero.headline')}</h1>
      <p class="hero-sub">{t('hero.subline')}</p>
      <div class="hero-cta">
        <a class="btn btn-primary" href={site.orderUrl}>{t('cta.orderOnline')}</a>
        <a class="btn btn-accent" href={site.woltUrl} target="_blank" rel="noopener">{t('cta.orderWolt')}</a>
      </div>
    </div>
  </div>
</section>
<style>
  .hero{min-height:78vh;background-size:cover;background-position:center;display:flex;align-items:center}
  .hero-overlay{width:100%;background:linear-gradient(0deg,rgba(0,0,0,.65),rgba(0,0,0,.25));padding:4rem 0;color:#fff}
  .hero-content{display:flex;flex-direction:column;align-items:center;text-align:center}
  .hero-logo{background:#fff;border-radius:18px;padding:.4rem;box-shadow:0 8px 30px rgba(0,0,0,.3);margin-bottom:1.2rem}
  .hero h1{font-size:clamp(2.4rem,6vw,4rem);margin:0}
  .hero-sub{font-size:clamp(1.05rem,2.5vw,1.35rem);max-width:34ch;margin:.6rem 0 1.8rem}
  .hero-cta{display:flex;flex-wrap:wrap;gap:.75rem;justify-content:center}
  .hero-cta .btn + .btn{margin-left:0}
</style>
